# Settings for Utility Asset Triage. Copy the names you need into Vercel:
# Project → Settings → Environment Variables. Never put real passwords in this file.

# REQUIRED on Vercel. The shared password people type to open the app.
# Locally, leave it unset to run without a password.
APP_PASSWORD=

# Optional. The username people type (default: triage).
APP_USERNAME=triage

# Optional. Timezone used for "today" and the "fetched at" time (default: America/Toronto).
APP_TIMEZONE=America/Toronto

# Optional. Which Google Sheet to read (the long ID in its link). Defaults to the demo sheet.
SHEET_ID=
